DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_SERVER=
POSTGRES_PORT=

# JWT Settings
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30


# Email Settings
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# STT (Speech-to-Text) API Keys – Transcription Module
WHISPER_API_KEY=sk-...
DEEPGRAM_API_KEY=...
ASSEMBLYAI_API_KEY=...

# ------------------------------------------------------------------
# LLM – Summarisation Module (provider-agnostic)
# Switch providers by changing just these three values — no code changes needed.
# ------------------------------------------------------------------

# Option 1: OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# Option 2: OpenRouter (100+ models, one key)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o          # or anthropic/claude-3-haiku, etc.

# Option 3: Groq (ultra-fast, free tier)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama3-70b-8192

# Option 4: Mistral
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-large-latest

# Option 5: Ollama (local, no key needed)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3
# LLM_API_KEY=no-key

LLM_API_KEY=your_provider_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_TIMEOUT=120